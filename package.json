{
  "name": "echo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "node ./scripts/postinstall-fix-expo-widgets.cjs",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "npm run test:core",
    "test:core": "node --test scripts/test-*.cjs",
    "test:widgets": "node --test scripts/test-widget-entries.cjs",
    "backend:dev": "npx vercel dev --listen 8787",
    "backend:build": "npm run compile --prefix backend",
    "backend:start": "npx vercel dev --listen 8787",
    "backend:typecheck": "npm run typecheck --prefix backend"
  },
  "dependencies": {
    "@expo/ui": "~57.0.9",
    "@expo/vector-icons": "^15.0.3",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "expo-widgets": "~57.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
